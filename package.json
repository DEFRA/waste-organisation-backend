{
  "name": "waste-organisation-backend",
  "version": "0.0.0",
  "description": "waste-organisation-backend",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run format:check && npm run lint && npm run test-long-timeout",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "npm run setup:husky",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "start:docker": "docker compose up --build",
    "stop:docker": "docker compose down",
    "test": "TZ=UTC vitest run --coverage",
    "test-long-timeout": "TZ=UTC vitest run --coverage --hook-timeout=1000000 --testTimeout=10000000",
    "test:watch": "TZ=UTC vitest"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1055.0",
    "@aws-sdk/client-sqs": "3.1061.0",
    "@aws-sdk/s3-request-presigner": "3.1011.0",
    "@azure/identity": "4.13.1",
    "@defra/cdp-auditing": "0.6.1",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.0",
    "@hapi/vision": "7.0.3",
    "aws-embedded-metrics": "4.2.1",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "exceljs": "4.4.0",
    "global-agent": "4.1.3",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.1",
    "hapi-swagger": "17.3.2",
    "https-proxy-agent": "9.0.0",
    "joi": "18.2.1",
    "mongo-locks": "3.0.2",
    "mongodb": "6.17.0",
    "node-fetch": "3.3.2",
    "notifications-node-client": "8.4.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "undici": "8.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.3.0",
    "@vitest/coverage-v8": "4.1.8",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "vitest": "4.1.7",
    "vitest-fetch-mock": "0.4.5",
    "vitest-mongodb": "1.0.3"
  },
  "overrides": {
    "notifications-node-client": {
      "axios": "1.16.0"
    },
    "exceljs": {
      "minimatch": "5.1.9",
      "uuid": "14.0.0"
    },
    "fast-xml-parser": "5.7.3",
    "hapi-swagger": {
      "joi": "18.2.1"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.59.0"
  }
}
